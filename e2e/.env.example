# FlowOptix E2E — copy to .env and fill in real values
# Never commit .env to version control

# Test account credentials
TEST_EMAIL=your-test-account@example.com
TEST_PASSWORD=your-test-password

# Browser: chrome | edge | firefox  (default: chrome)
BROWSER=chrome

# Headless: true | false  (default: true)
HEADLESS=true

# Base URL (default shown — override for staging)
BASE_URL=https://flowoptix-ten.vercel.app
